{
  "name": "ProcessDiagram",
  "type": "object",
  "properties": {
    "process_id": {
      "type": "string",
      "description": "Reference to OrgProcess entity this diagram models"
    },
    "process_code": {
      "type": "string",
      "description": "Process code (denormalized)"
    },
    "process_name": {
      "type": "string",
      "description": "Process name (denormalized)"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "bpmn_xml": {
      "type": "string",
      "description": "BPMN 2.0 XML diagram source (bpmn-js)"
    },
    "svg_snapshot": {
      "type": "string",
      "description": "Last exported SVG snapshot of the diagram (for previews / thumbnails / reports)"
    },
    "canvas_meta": {
      "type": "object",
      "description": "Canvas-level (global) BPMN-to-SOP metadata for this diagram. Links to Process Management (basic) and holds the SOP header / context fields. Allows overriding the process name."
    },
    "element_meta": {
      "type": "object",
      "description": "Per-BPMN-element SOP metadata, keyed by element id. Each value is an object of the fields shown for that element's category in the Data Pane."
    },
    "version_label": {
      "type": "string",
      "description": "Optional version label e.g. v1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "description": "Diagram lifecycle status"
    },
    "notes": {
      "type": "string",
      "description": "Modelling notes"
    }
  },
  "required": [
    "process_id",
    "bpmn_xml"
  ]
}