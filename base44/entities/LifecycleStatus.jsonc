{
  "name": "LifecycleStatus",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Lifecycle status name (e.g. Discovered, Identified, In Service, Maintenance, Quarantined, Retiring, Retired, Stale, Unknown)"
    },
    "code": {
      "type": "string",
      "description": "Short code (e.g. discovered, in_service, retired, stale)"
    },
    "description": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 100
    },
    "is_terminal": {
      "type": "boolean",
      "default": false,
      "description": "True for terminal states like Retired/Stale \u2014 CIs in these states remain available for historical reporting and are not auto-deleted"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "True for predefined system lifecycle statuses"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity for company-specific extensions. Null/blank = global."
    }
  },
  "required": [
    "name"
  ]
}