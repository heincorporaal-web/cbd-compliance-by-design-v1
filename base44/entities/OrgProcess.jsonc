{
  "name": "OrgProcess",
  "type": "object",
  "properties": {
    "process_code": {
      "type": "string",
      "description": "Unique process identifier (e.g., P1.1.2.1)"
    },
    "name": {
      "type": "string",
      "description": "Process name"
    },
    "description": {
      "type": "string",
      "description": "Detailed process description"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "level": {
      "type": "number",
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "description": "Process hierarchy level"
    },
    "parent_id": {
      "type": "string"
    },
    "value_chain": {
      "type": "string"
    },
    "process_owner": {
      "type": "string"
    },
    "process_owner_id": {
      "type": "string",
      "description": "Reference to User entity (process owner)"
    },
    "process_owner_stakeholder_id": {
      "type": "string",
      "description": "Reference to Stakeholder entity (process owner)"
    },
    "deputy_owner": {
      "type": "string"
    },
    "global_control_owner": {
      "type": "string"
    },
    "workstream": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "archived",
        "under_review"
      ],
      "default": "active"
    },
    "linked_system_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_it_capability_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_goal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_assessment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_principle_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_org_objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documentation_url": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "continuous",
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "annually",
        "ad_hoc"
      ]
    },
    "estimated_duration": {
      "type": "string"
    },
    "automation_level": {
      "type": "string",
      "enum": [
        "manual",
        "semi_automated",
        "fully_automated"
      ],
      "default": "manual"
    },
    "criticality": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "inputs": {
      "type": "string"
    },
    "outputs": {
      "type": "string"
    },
    "key_performance_indicators": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "minimum_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "workflow_instance_id": {
      "type": "string",
      "description": "Active WorkflowInstance ID"
    },
    "workflow_status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "comments": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "process_code",
    "name",
    "company_id",
    "level"
  ]
}