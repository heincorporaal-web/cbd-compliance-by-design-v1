{
  "name": "Survey",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "linked_entity_type": {
      "type": "string",
      "enum": [
        "ICTSystem",
        "ThirdPartyProvider",
        "Framework",
        "ITCapability"
      ]
    },
    "linked_entity_id": {
      "type": "string"
    },
    "linked_entity_name": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "single_choice",
              "multiple_choice",
              "rating",
              "yes_no"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "closed"
      ],
      "default": "draft"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          }
        }
      }
    },
    "reminder_schedule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "frequency_days": {
          "type": "number"
        },
        "last_sent": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ai_analysis": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "key_findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sentiment": {
          "type": "string"
        },
        "concerns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_analyzed": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "workflow_instance_id": {
      "type": "string",
      "description": "Active WorkflowInstance ID"
    },
    "workflow_status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "comments": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "linked_entity_type",
    "linked_entity_id"
  ]
}