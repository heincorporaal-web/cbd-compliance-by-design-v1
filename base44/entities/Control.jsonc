{
  "name": "Control",
  "type": "object",
  "properties": {
    "framework_id": {
      "type": "string",
      "description": "Reference to Framework entity"
    },
    "control_id": {
      "type": "string",
      "description": "Control identifier (e.g., CTCM.FINMC.1.01)"
    },
    "title": {
      "type": "string",
      "description": "Control title"
    },
    "description": {
      "type": "string",
      "description": "Control description"
    },
    "category": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "returned",
        "approved",
        "active",
        "archived"
      ],
      "default": "draft"
    },
    "global": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a global control"
    },
    "control_ccm": {
      "type": "boolean",
      "default": false,
      "description": "Control CCM flag"
    },
    "self_assessment": {
      "type": "boolean",
      "default": false,
      "description": "Self assessment flag"
    },
    "control_criticality": {
      "type": "string",
      "enum": [
        "Must Have",
        "Should Have",
        "Nice to Have"
      ],
      "default": "Should Have"
    },
    "control_owner": {
      "type": "string",
      "description": "Control owner role/name"
    },
    "owner_stakeholder_id": {
      "type": "string",
      "description": "Reference to Stakeholder entity (control owner)"
    },
    "key_control": {
      "type": "boolean",
      "default": false
    },
    "control_execution_type": {
      "type": "string",
      "enum": [
        "Manual",
        "Automated",
        "Semi-Automated"
      ],
      "default": "Manual"
    },
    "control_type": {
      "type": "string",
      "enum": [
        "Preventive",
        "Detective",
        "Corrective"
      ],
      "default": "Preventive"
    },
    "finance_control_consideration": {
      "type": "boolean",
      "default": false
    },
    "control_frequency": {
      "type": "string",
      "enum": [
        "Daily",
        "Weekly",
        "Monthly",
        "Quarterly",
        "Annually",
        "Continuous",
        "Ad-hoc"
      ],
      "default": "Monthly"
    },
    "compensating_control": {
      "type": "boolean",
      "default": false
    },
    "compensating_control_risk": {
      "type": "string"
    },
    "control_narrative_url": {
      "type": "string"
    },
    "upload_document": {
      "type": "string",
      "description": "Document upload flag or URL"
    },
    "control_objective_id": {
      "type": "string",
      "description": "Reference to control objective"
    },
    "process_phase": {
      "type": "string",
      "enum": [
        "Pre-Input",
        "Process - Input",
        "Process - Output",
        "Post-Output"
      ],
      "default": "Process - Input"
    },
    "risk_id": {
      "type": "string",
      "description": "Associated risk ID from library"
    },
    "is_library_control": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a master library control"
    },
    "library_control_id": {
      "type": "string",
      "description": "Source library control ID if assigned from master library"
    },
    "library_status": {
      "type": "string",
      "enum": [
        "active",
        "retired",
        "draft"
      ],
      "default": "active",
      "description": "Lifecycle status of this master library control entry (active, retired, or draft)"
    },
    "library_end_date": {
      "type": "string",
      "format": "date",
      "description": "End date when this master library control was retired"
    },
    "reviewer": {
      "type": "string",
      "description": "Reviewer name (denormalized)"
    },
    "reviewer_stakeholder_id": {
      "type": "string",
      "description": "Reference to Stakeholder entity (reviewer)"
    },
    "approver": {
      "type": "string",
      "description": "Approver / control owner name (denormalized)"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time"
    },
    "return_comments": {
      "type": "string"
    },
    "lifecycle_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "comments": {
            "type": "string"
          }
        }
      }
    },
    "linked_objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compensating_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workflow_instance_id": {
      "type": "string",
      "description": "Active WorkflowInstance ID"
    },
    "workflow_status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "comments": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "framework_id",
    "control_id",
    "title"
  ]
}