{
  "name": "CISubclass",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "CI subclass name (e.g. Rack Server, Blade Server)"
    },
    "code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "parent_class_id": {
      "type": "string",
      "description": "Reference to CIClass entity this subclass belongs to"
    },
    "parent_class_name": {
      "type": "string",
      "description": "Parent class name (denormalized)"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity for company-specific extensions. Null/blank = global."
    },
    "sort_order": {
      "type": "number",
      "default": 100
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "parent_class_id"
  ]
}