{
  "name": "ThirdPartyProvider",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Provider name"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity using this provider"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "cloud_hosting",
        "software_as_service",
        "managed_security",
        "data_center",
        "payment_processing",
        "it_support",
        "consulting",
        "other"
      ],
      "description": "Type of service provided"
    },
    "criticality": {
      "type": "string",
      "enum": [
        "critical",
        "important",
        "supporting"
      ],
      "default": "supporting",
      "description": "Criticality to business operations"
    },
    "contract_start_date": {
      "type": "string",
      "format": "date",
      "description": "Contract start date"
    },
    "contract_end_date": {
      "type": "string",
      "format": "date",
      "description": "Contract end date"
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact at provider"
    },
    "contact_email": {
      "type": "string",
      "format": "email",
      "description": "Contact email"
    },
    "last_audit_date": {
      "type": "string",
      "format": "date",
      "description": "Last audit or assessment date"
    },
    "next_audit_date": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled audit"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Provider certifications (ISO 27001, SOC 2, etc.)"
    },
    "risk_rating": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "under_review",
        "terminated",
        "onboarding"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "third_party_reference": {
      "type": "string",
      "description": "Third Party Reference (unique internal reference for the third party record)"
    },
    "legal_name": {
      "type": "string",
      "description": "Registered legal name of the third party"
    },
    "trading_name": {
      "type": "string",
      "description": "Trading / doing-business-as name"
    },
    "registration_number": {
      "type": "string",
      "description": "Company / registration number"
    },
    "tax_number": {
      "type": "string",
      "description": "Tax / VAT identification number"
    },
    "country_of_registration": {
      "type": "string",
      "description": "Country in which the third party is legally registered"
    },
    "headquarters_country": {
      "type": "string",
      "description": "Country of the third party's headquarters"
    },
    "third_party_type": {
      "type": "string",
      "enum": [
        "supplier",
        "outsourcing_provider",
        "cloud_service_provider",
        "consultant",
        "distributor",
        "agent",
        "data_processor",
        "managed_service_provider",
        "subcontractor",
        "strategic_partner",
        "fourth_party_provider"
      ],
      "description": "Classification of the third party"
    },
    "parent_company_id": {
      "type": "string",
      "description": "Parent third party (for fourth-party / subcontractor relationships) \u2014 reference to another ThirdPartyProvider"
    },
    "website": {
      "type": "string",
      "description": "Third party website URL"
    },
    "primary_contact_name": {
      "type": "string",
      "description": "Primary contact name"
    },
    "primary_contact_email": {
      "type": "string",
      "format": "email",
      "description": "Primary contact email"
    },
    "primary_contact_telephone": {
      "type": "string",
      "description": "Primary contact telephone number"
    },
    "procurement_owner_id": {
      "type": "string",
      "description": "Stakeholder ID \u2014 procurement owner"
    },
    "procurement_owner_name": {
      "type": "string",
      "description": "Procurement owner name (denormalized)"
    },
    "date_created": {
      "type": "string",
      "format": "date",
      "description": "Date the third party record / relationship was created (business date)"
    },
    "date_approved": {
      "type": "string",
      "format": "date",
      "description": "Date the third party was approved"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the third party record is currently active"
    },
    "tprm_enabled": {
      "type": "boolean",
      "default": false,
      "description": "True when Third Party Risk Management is being tracked for this provider"
    },
    "inherent_risk_rating": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Inherent third-party risk rating (before controls)"
    },
    "residual_risk_rating": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Residual third-party risk rating (after controls)"
    },
    "linked_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Inherent & residual risks from the risk library linked to this third party"
    },
    "linked_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Controls expected from the third party and from your organisation"
    },
    "linked_framework_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Frameworks whose questions/controls are mapped to this third party (ISO 27001, NIST, DORA, GDPR, COBIT, etc.)"
    },
    "linked_value_chain_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Value chains / business activities that depend on this third party"
    },
    "linked_workstream_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Workstreams that depend on this third party"
    },
    "linked_process_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Processes linked to the services delivered by this third party"
    },
    "linked_ict_system_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Systems, applications, data and infrastructure operated by the third party"
    },
    "linked_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Issues and remediation actions tracked for this third party"
    },
    "linked_incident_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Incidents caused by or affecting this third party"
    },
    "service_owner_id": {
      "type": "string",
      "description": "Stakeholder ID \u2013 service owner"
    },
    "service_owner_name": {
      "type": "string"
    },
    "relationship_owner_id": {
      "type": "string",
      "description": "Stakeholder ID \u2013 relationship owner"
    },
    "relationship_owner_name": {
      "type": "string"
    },
    "risk_owner_id": {
      "type": "string",
      "description": "Stakeholder ID \u2013 risk owner"
    },
    "risk_owner_name": {
      "type": "string"
    },
    "approver_id": {
      "type": "string",
      "description": "Stakeholder ID \u2013 approver"
    },
    "approver_name": {
      "type": "string"
    },
    "business_continuity_critical": {
      "type": "boolean",
      "default": false,
      "description": "True if this third party supports a critical/business-continuity service"
    },
    "bcp_recovery_notes": {
      "type": "string",
      "description": "Business continuity / dependency & recovery notes"
    },
    "tprm_notes": {
      "type": "string",
      "description": "Third Party Risk Management notes"
    }
  },
  "required": [
    "name",
    "company_id",
    "service_type",
    "criticality"
  ]
}