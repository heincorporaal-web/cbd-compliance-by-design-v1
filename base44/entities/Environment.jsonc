{
  "name": "Environment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Environment name (e.g. Production, Development, Test, UAT, Disaster Recovery)"
    },
    "code": {
      "type": "string",
      "description": "Short code (e.g. prod, dev, test, uat, dr)"
    },
    "description": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 100
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "True for predefined system environments"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity for company-specific extensions. Null/blank = global."
    }
  },
  "required": [
    "name"
  ]
}