{
  "name": "BusinessUnit",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Business unit name"
    },
    "description": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "type": {
      "type": "string",
      "enum": [
        "Profit & Loss Unit",
        "Department",
        "Capability",
        "Center of Excellence",
        "Division",
        "Business Line",
        "Function",
        "Region",
        "Country",
        "Legal Entity",
        "Shared Services",
        "Project Office",
        "Team",
        "Other"
      ],
      "default": "Department"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent BusinessUnit ID (for hierarchy)"
    },
    "value_chain_id": {
      "type": "string",
      "description": "Reference to ValueChain entity"
    },
    "workstream_id": {
      "type": "string",
      "description": "Reference to Workstream entity (must belong to selected value chain)"
    },
    "owner_stakeholder_id": {
      "type": "string",
      "description": "Reference to Stakeholder (unit owner)"
    },
    "owner_name": {
      "type": "string",
      "description": "Owner name (denormalized)"
    },
    "cost_center_code": {
      "type": "string",
      "description": "Cost center or GL code"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "company_id",
    "type"
  ]
}