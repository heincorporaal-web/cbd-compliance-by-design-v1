{
  "name": "UserRole",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Role name"
    },
    "description": {
      "type": "string",
      "description": "Role description"
    },
    "is_system_role": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a system role (cannot be deleted)"
    },
    "is_product_owner": {
      "type": "boolean",
      "default": false,
      "description": "True for the Product Owner role \u2014 maintains the master framework library and can never be associated with a company"
    },
    "active_from": {
      "type": "string",
      "format": "date",
      "description": "Date from which this role is active"
    },
    "active_to": {
      "type": "string",
      "format": "date",
      "description": "Date until which this role is active (expiry). Leave blank for no expiry."
    },
