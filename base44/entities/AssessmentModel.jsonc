{
  "name": "AssessmentModel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Model name (e.g. IT Governance ISO27001)"
    },
    "description": {
      "type": "string"
    },
    "analysis_type": {
      "type": "string",
      "enum": [
        "Qualitative",
        "Quantitative",
        "Semi-Quantitative",
        "Maturity Assessment",
        "Supplier Services",
        "Criticality"
      ],
      "default": "Qualitative"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_edit",
        "active",
        "archived"
      ],
      "default": "draft"
    },
    "company_id": {
      "type": "string"
    },
    "is_global": {
      "type": "boolean",
      "default": false
    },
    "revision": {
      "type": "number",
      "default": 1
    },
    "revision_date": {
      "type": "string",
      "format": "date"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "ratings_formula": {
      "type": "string",
      "enum": [
        "product",
        "weighted_product",
        "hybrid_maturity"
      ],
      "default": "product",
      "description": "Formula / scoring method: Product (L\u00d7I), Weighted Product, or Hybrid Maturity (qualitative + quantitative combined)"
    },
    "impact_levels": {
      "type": "array",
      "description": "Impact scoring bands (Qualitative/Quantitative/Semi-Quantitative models)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "low_value": {
            "type": "number"
          },
          "high_value": {
            "type": "number"
          },
          "weight_pct": {
            "type": "number"
          },
          "color_hex": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "likelihood_levels": {
      "type": "array",
      "description": "Likelihood scoring bands (Qualitative/Quantitative/Semi-Quantitative models)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "low_value": {
            "type": "number"
          },
          "high_value": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "maturity_levels": {
      "type": "array",
      "description": "Maturity levels for Hybrid Maturity models \u2014 each level combines a qualitative label with a quantitative score range",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "level_number": {
            "type": "number",
            "description": "Maturity level number (e.g. 1\u20135)"
          },
          "qualitative_label": {
            "type": "string",
            "description": "Qualitative label (e.g. Initial, Managed, Optimizing)"
          },
          "quantitative_label": {
            "type": "string",
            "description": "Optional quantitative descriptor (e.g. Ad-hoc)"
          },
          "score_low": {
            "type": "number",
            "description": "Lower bound of quantitative score range"
          },
          "score_high": {
            "type": "number",
            "description": "Upper bound of quantitative score range"
          },
          "description": {
            "type": "string"
          },
          "color_hex": {
            "type": "string"
          }
        }
      }
    },
    "rating_options": {
      "type": "array",
      "description": "Rating options for Supplier Services or Criticality models",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "color_hex": {
            "type": "string"
          },
          "sort_order": {
            "type": "number"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "analysis_type"
  ]
}