{
  "name": "OrgObjective",
  "type": "object",
  "properties": {
    "reference_number": {
      "type": "string",
      "description": "Auto-generated reference number"
    },
    "title": {
      "type": "string",
      "description": "Objective title"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the objective"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "category": {
      "type": "string",
      "enum": [
        "Compliance",
        "IT Compliance",
        "Operational",
        "Financial",
        "Client Relations",
        "Resilience",
        "Data",
        "Fundamentals"
      ],
      "default": "Operational",
      "description": "Objective category"
    },
    "strategic_theme": {
      "type": "string",
      "description": "Free text strategic theme"
    },
    "objective_type": {
      "type": "string",
      "enum": [
        "Strategic",
        "Tactical",
        "Regulatory",
        "Operational"
      ],
      "default": "Strategic"
    },
    "priority_rating_numeric": {
      "type": "number",
      "description": "Priority rating 1-5"
    },
    "priority_rating_label": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical",
        "Imperative"
      ],
      "description": "Priority rating label scale"
    },
    "criticality": {
      "type": "string",
      "enum": [
        "Must Have",
        "Should Have",
        "Could Have",
        "Won't Have"
      ],
      "default": "Must Have",
      "description": "MoSCoW criticality"
    },
    "time_horizon": {
      "type": "string",
      "enum": [
        "Annual",
        "3 Year",
        "5 Year",
        "Continuous"
      ],
      "default": "Annual"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_to": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Approved",
        "Active",
        "Under Review",
        "Retired"
      ],
      "default": "Draft"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection if approval_status is Rejected"
    },
    "approved_by": {
      "type": "string",
      "description": "Name of approver"
    },
    "next_review_date": {
      "type": "string",
      "format": "date",
      "description": "Next review date (triggers calendar event)"
    },
    "objective_owner": {
      "type": "string",
      "description": "Objective owner"
    },
    "performance_owner": {
      "type": "string",
      "description": "Performance owner"
    },
    "compliance_owner": {
      "type": "string",
      "description": "Compliance owner (optional)"
    },
    "it_owner": {
      "type": "string",
      "description": "IT owner (optional)"
    },
    "notes": {
      "type": "string"
    },
    "parent_objective_id": {
      "type": "string",
      "description": "Parent objective ID"
    },
    "linked_strategic_theme_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_capability_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_value_chain_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_business_unit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_framework_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_process_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_ihpom_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kpis": {
      "type": "array",
      "description": "KPI measurements for this objective",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "measurement_name": {
            "type": "string"
          },
          "measurement_type": {
            "type": "string",
            "enum": [
              "Numeric",
              "Judgemental",
              "Logic"
            ]
          },
          "measurement_description": {
            "type": "string"
          },
          "calculation_method": {
            "type": "string"
          },
          "data_source_link": {
            "type": "string"
          },
          "linked_scorecard_id": {
            "type": "string",
            "description": "Reference to BalancedScorecard this KPI rolls up into"
          }
        }
      }
    },
    "progress_pct": {
      "type": "number",
      "description": "Progress percentage (0-100)"
    },
    "key_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "current": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "company_id",
    "category"
  ]
}