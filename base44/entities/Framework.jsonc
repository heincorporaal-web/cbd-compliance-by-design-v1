{
  "name": "Framework",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Framework name (e.g., ISO 27001, NIST CSF)"
    },
    "version": {
      "type": "string",
      "description": "Framework version"
    },
    "description": {
      "type": "string",
      "description": "Framework description"
    },
    "category": {
      "type": "string",
      "enum": [
        "information_security",
        "privacy",
        "compliance",
        "operational_risk",
        "financial",
        "other"
      ],
      "description": "Framework category"
    },
    "framework_code": {
      "type": "string",
      "description": "Short code / identifier (e.g. COSO, ISO27001, DORA)"
    },
    "framework_family": {
      "type": "string",
      "description": "Framework family / grouping (e.g. GRC/Audit Management, IT and Cybersecurity)"
    },
    "issuing_body": {
      "type": "string",
      "description": "Body that issues or owns the framework"
    },
    "is_master": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a master library framework (not company-specific)"
    },
    "sort_order": {
      "type": "number",
      "description": "Display sort order"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "returned",
        "approved",
        "active",
        "archived"
      ],
      "default": "draft",
      "description": "Framework lifecycle status"
    },
    "reviewer": {
      "type": "string"
    },
    "approver": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time"
    },
    "return_comments": {
      "type": "string"
    },
    "lifecycle_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "comments": {
            "type": "string"
          }
        }
      }
    },
    "linked_objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_principle_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workflow_instance_id": {
      "type": "string",
      "description": "Active WorkflowInstance ID"
    },
    "workflow_status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "comments": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "category"
  ]
}