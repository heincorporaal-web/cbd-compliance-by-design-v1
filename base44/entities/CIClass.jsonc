{
  "name": "CIClass",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "CI class name (e.g. Physical Server, Virtual Machine, Network Device)"
    },
    "code": {
      "type": "string",
      "description": "Short code / identifier (e.g. physical_server, vm, network_device)"
    },
    "description": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity for company-specific extensions. Null/blank = global system catalogue entry."
    },
    "sort_order": {
      "type": "number",
      "default": 100
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "True for predefined system classes that cannot be deleted"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}