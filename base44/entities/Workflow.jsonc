{
  "name": "Workflow",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Workflow name"
    },
    "description": {
      "type": "string",
      "description": "Workflow description"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "Assessment",
        "ProcessAssessment",
        "BusinessProcess",
        "Risk",
        "Control",
        "Framework",
        "Issue",
        "OrgProcess"
      ],
      "description": "Entity type this workflow applies to"
    },
    "trigger_condition": {
      "type": "string",
      "enum": [
        "on_create",
        "on_update",
        "on_status_change",
        "manual"
      ],
      "default": "manual"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "approval",
              "notification",
              "action",
              "return_to_originator",
              "parallel_approval",
              "conditional",
              "escalation",
              "delay"
            ]
          },
          "assignee_type": {
            "type": "string",
            "enum": [
              "named_emails",
              "stakeholder_group",
              "dynamic_role",
              "named_stakeholders"
            ],
            "default": "named_emails",
            "description": "How assignees/approvers are resolved"
          },
          "approvers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Static email addresses (used when assignee_type=named_emails)"
          },
          "stakeholder_group_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Stakeholder group IDs whose members become approvers (assignee_type=stakeholder_group)"
          },
          "named_stakeholder_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Specific Stakeholder record IDs to assign (assignee_type=named_stakeholders)"
          },
          "dynamic_role_field": {
            "type": "string",
            "description": "Field on the entity to read the assignee from, e.g. process_owner, process_owner_id, process_owner_stakeholder_id"
          },
          "assigned_user_emails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notification_template": {
            "type": "string"
          },
          "recipients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recipient_assignee_type": {
            "type": "string",
            "enum": [
              "named_emails",
              "stakeholder_group",
              "dynamic_role",
              "named_stakeholders"
            ],
            "default": "named_emails"
          },
          "recipient_stakeholder_group_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recipient_named_stakeholder_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recipient_dynamic_role_field": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "require_all_approvers": {
            "type": "boolean",
            "default": false
          },
          "min_approvals": {
            "type": "number"
          },
          "comment_required": {
            "type": "boolean",
            "default": false
          },
          "escalation_after_days": {
            "type": "number"
          },
          "escalation_emails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "delay_hours": {
            "type": "number"
          },
          "condition_field": {
            "type": "string"
          },
          "condition_operator": {
            "type": "string",
            "enum": [
              "equals",
              "not_equals",
              "contains",
              "greater_than",
              "less_than"
            ]
          },
          "condition_value": {
            "type": "string"
          },
          "condition_true_step": {
            "type": "number"
          },
          "condition_false_step": {
            "type": "number"
          },
          "return_reason_required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "auto_notify_days_before": {
      "type": "number"
    },
    "allow_originator_resubmit": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "entity_type"
  ]
}