{
  "name": "AppMeta",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Version label e.g. v1.2"
    },
    "release_date": {
      "type": "string",
      "format": "date",
      "description": "Release / build date"
    },
    "app_name": {
      "type": "string",
      "description": "Application display name"
    },
    "tagline": {
      "type": "string",
      "description": "Short one-line tagline"
    },
    "description": {
      "type": "string",
      "description": "Longer description of the application"
    },
    "release_notes": {
      "type": "string",
      "description": "Release notes / changelog summary"
    },
    "user_terms": {
      "type": "string",
      "description": "Compliance by Design Platform \u2013 User Terms (editable plain text / markdown)"
    },
    "acceptable_use_policy": {
      "type": "string",
      "description": "Acceptable Use Policy (editable plain text / markdown)"
    },
    "last_updated_by": {
      "type": "string",
      "description": "Name of the user who last updated this record"
    },
    "nav_icon_overrides": {
      "type": "object",
      "description": "Admin-defined navigation menu icons. Map of nav item id to a lucide icon name, applied app-wide.",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "app_name"
  ]
}