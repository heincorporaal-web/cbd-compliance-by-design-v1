{
  "name": "KnowledgeArticle",
  "type": "object",
  "properties": {
    "reference_number": {
      "type": "string",
      "description": "Auto-generated reference number e.g. EDM-CHL-001"
    },
    "shortcode": {
      "type": "string",
      "description": "Unique shortcode (max 4 characters) e.g. EDM"
    },
    "title": {
      "type": "string",
      "description": "Article title"
    },
    "framework_id": {
      "type": "string",
      "description": "Optional reference to Framework entity"
    },
    "chapter": {
      "type": "string",
      "description": "Framework chapter or domain (e.g., Access Control, Cryptography)"
    },
    "key_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "reference_number": {
            "type": "string",
            "description": "Step reference e.g. EDM-CHL-001"
          },
          "expected_artefacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Expected artefacts or evidence items for this step"
          }
        }
      },
      "description": "Key implementation steps"
    },
    "description": {
      "type": "string",
      "description": "Article description"
    },
    "content": {
      "type": "string",
      "description": "Full article content"
    },
    "source_url": {
      "type": "string",
      "description": "Link to the original external article (e.g. SharePoint, Confluence, vendor docs). Primarily used for Wiki Article category."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorization"
    },
    "category": {
      "type": "string",
      "enum": [
        "implementation_guide",
        "best_practice",
        "policy_template",
        "procedure",
        "checklist",
        "wiki_article"
      ],
      "description": "Article category"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL to attached PDF documentation"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "description": "Additional attachments"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "description": "Article status"
    }
  },
  "required": [
    "title",
    "shortcode"
  ]
}