{
  "name": "Risk",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Risk title / Risk Statement"
    },
    "description": {
      "type": "string",
      "description": "Detailed risk description"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity (null for master library risks)"
    },
    "category": {
      "type": "string",
      "enum": [
        "operational",
        "financial",
        "strategic",
        "compliance",
        "cyber_security",
        "third_party",
        "reputational",
        "technology"
      ],
      "default": "operational"
    },
    "likelihood": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "medium",
        "high",
        "very_high"
      ],
      "default": "medium"
    },
    "impact": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "medium",
        "high",
        "very_high"
      ],
      "default": "medium"
    },
    "inherent_risk_score": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "identified",
        "auto_assigned",
        "pending_review",
        "returned",
        "approved",
        "assessed",
        "mitigated",
        "accepted",
        "closed"
      ],
      "default": "identified"
    },
    "owner": {
      "type": "string",
      "description": "Risk owner name (denormalized from stakeholder)"
    },
    "owner_stakeholder_id": {
      "type": "string",
      "description": "Reference to Stakeholder entity (risk owner)"
    },
    "mitigation_plan": {
      "type": "string"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "identified_date": {
      "type": "string",
      "format": "date"
    },
    "control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "framework_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workflow_instance_id": {
      "type": "string",
      "description": "Active WorkflowInstance ID"
    },
    "workflow_status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "comments": {
            "type": "string"
          }
        }
      },
      "description": "Status change history driven by workflow"
    },
    "risk_reference_nr": {
      "type": "string",
      "description": "Risk reference number (e.g. RTCM.FINMC.1.01)"
    },
    "risk_type": {
      "type": "string",
      "description": "Risk type classification (e.g. Financial, Operational, Strategic, Governance & Compliance)",
      "enum": [
        "Financial",
        "Operational",
        "Strategic",
        "Governance & Compliance",
        "Governance",
        "Unspecified"
      ]
    },
    "racm_risk_type": {
      "type": "string",
      "description": "RACM risk type (may differ from primary risk type)"
    },
    "risk_statement": {
      "type": "string",
      "description": "Formal risk statement describing what could go wrong"
    },
    "root_cause": {
      "type": "string",
      "description": "Narrative description of the root cause"
    },
    "root_cause_category_id": {
      "type": "string",
      "description": "Reference to RootCauseCategory entity"
    },
    "root_cause_type": {
      "type": "string",
      "description": "Specific root cause type label (denormalized)"
    },
    "value_chain": {
      "type": "string",
      "description": "Value chain this risk belongs to (e.g. FIN - Order to Cash)"
    },
    "sub_process": {
      "type": "string",
      "description": "Sub-process within the value chain"
    },
    "workstream": {
      "type": "string",
      "description": "Workstream associated with this risk"
    },
    "ihpom_node_id": {
      "type": "string",
      "description": "iHPOM node ID reference"
    },
    "racm_l3": {
      "type": "string",
      "description": "RACM Level 3 process step (e.g. Manage Cash)"
    },
    "process_activity": {
      "type": "string",
      "description": "Process activity / step name (activity name only, without reference number)"
    },
    "framework_reference": {
      "type": "string",
      "description": "Framework reference text (e.g. IFRS ICFR)"
    },
    "is_library_risk": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a master library risk not yet assigned to a company"
    },
    "library_risk_id": {
      "type": "string",
      "description": "Source library risk ID if this risk was assigned from the master library"
    }
  },
  "required": [
    "title",
    "company_id"
  ]
}