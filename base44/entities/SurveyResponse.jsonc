{
  "name": "SurveyResponse",
  "type": "object",
  "properties": {
    "survey_id": {
      "type": "string",
      "description": "Reference to Survey entity"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Survey answers"
    },
    "respondent_name": {
      "type": "string",
      "description": "Name of person who completed survey"
    },
    "respondent_email": {
      "type": "string",
      "format": "email",
      "description": "Email of respondent"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When survey was completed"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "survey_id",
    "responses"
  ]
}