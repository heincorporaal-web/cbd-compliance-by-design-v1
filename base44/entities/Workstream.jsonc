{
  "name": "Workstream",
  "type": "object",
  "properties": {
    "workstream_code": {
      "type": "string",
      "description": "Short code / identifier (e.g. ORDM)"
    },
    "name": {
      "type": "string",
      "description": "Workstream name"
    },
    "full_label": {
      "type": "string",
      "description": "Full display label (e.g. SCM - O2C-Order Management)"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the workstream"
    },
    "value_chain_id": {
      "type": "string",
      "description": "Reference to ValueChain entity"
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity"
    },
    "domain_code": {
      "type": "string",
      "description": "Domain code (e.g. SCM, EIT, GRC, HCM, FIN, EPM)"
    },
    "e2e_code": {
      "type": "string",
      "description": "End-to-end process code (e.g. O2C, P2P, H2R)"
    },
    "sort_order": {
      "type": "number",
      "description": "Display sort order"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this workstream is active"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "value_chain_id",
    "company_id"
  ]
}