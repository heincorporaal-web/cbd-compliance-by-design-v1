{
  "name": "RelationshipType",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Relationship type name (e.g. Hosted On, Runs On, Depends On, Connects To)"
    },
    "code": {
      "type": "string",
      "description": "Short code / identifier (e.g. hosted_on, runs_on, depends_on)"
    },
    "category": {
      "type": "string",
      "enum": [
        "ci_to_ci",
        "application_to_ci"
      ],
      "description": "Whether this relationship type applies to CI-to-CI or Application-to-CI relationships"
    },
    "direction": {
      "type": "string",
      "enum": [
        "parent_child",
        "peer",
        "dependency"
      ],
      "default": "parent_child",
      "description": "Relationship direction semantics"
    },
    "description": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 100
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "True for predefined system relationship types that cannot be deleted"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "company_id": {
      "type": "string",
      "description": "Reference to Company entity for company-specific extensions. Null/blank = global."
    }
  },
  "required": [
    "name",
    "category"
  ]
}