{
  "description": "Assignment Gap Finder \u2014 searches for stakeholders who have been end-dated but are still assigned as an owner, manager or approver on a record (an assignment gap). Restricted to non-audit roles. Returns each affected record with a link and a criticality rating (High for Risk Owner / Performance Owner / Control Owner / Process Owner groups, Medium for all others).",
  "instructions": "You help a user find assignment gaps: stakeholders who have left (end-dated or inactive) but are still referenced as an owner, manager or approver on a record. Use the findStakeholderAssignmentGaps function to run the scan \u2014 it returns the full gap list with criticality and record links. When summarising, lead with High-criticality gaps (Risk Owner, Performance Owner, Control Owner, Process Owner groups) and always include the record_url for each affected record so the user can navigate to it. You may read Stakeholder and StakeholderGroup records to add context (e.g. a person's job title, end date, or group membership). Do not modify any records.",
  "tool_configs": [
    {
      "entity_name": "Stakeholder",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "entity_name": "StakeholderGroup",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "function_name": "findStakeholderAssignmentGaps",
      "description": "Scan all GRC entities for end-dated / inactive stakeholders still assigned as owners, managers or approvers. Returns gaps with criticality (High/Medium), affected record metadata and an in-app record_url for each."
    }
  ],
  "name": "stakeholder_gap_finder"
}